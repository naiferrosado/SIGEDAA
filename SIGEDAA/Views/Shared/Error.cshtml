@model ErrorViewModel
@{
    ViewData["Title"] = "Error del sistema";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0">
                <div class="card-body p-5 text-center">
                    <h1 class="text-danger fw-bold mb-3">Ha ocurrido un error</h1>
                    <p class="lead text-muted mb-4">
                        No pudimos procesar tu solicitud en este momento. Puedes volver al panel principal e intentarlo nuevamente.
                    </p>

                    @if (Model.ShowRequestId)
                    {
                        <div class="alert alert-light border text-start d-inline-block mb-4">
                            <strong>ID de solicitud:</strong> <code>@Model.RequestId</code>
                        </div>
                    }

                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                            Volver al dashboard
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                            Ir al inicio
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
