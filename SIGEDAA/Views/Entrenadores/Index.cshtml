@model IEnumerable<SIGEDAA.Models.Entrenador>

@{
    ViewData["Title"] = "Entrenadores";
    var puedeGestionarEntrenadores = User.IsInRole("Administrador") || User.IsInRole("Presidente");
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="container mt-4">

    <div class="page-header">
        <div>
            <h1>Entrenadores</h1>
            <p>Administra los entrenadores registrados, su especialidad y los clubes que dirigen.</p>
        </div>

        <div class="page-actions">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary shadow-sm">
                Dashboard
            </a>
            @if (puedeGestionarEntrenadores)
            {
                <a asp-action="Create" class="btn btn-primary shadow-sm">
                    Nuevo Entrenador
                </a>
            }
        </div>
    </div>

    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body">

            <table id="tablaEntrenadores" class="table table-hover align-middle table-bordered" style="width:100%">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nombre Completo</th>
                        <th>Club</th>
                        <th>Especialidad</th>
                        <th>Experiencia</th>
                        <th>Teléfono</th>
                        <th>Correo</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.IdEntrenador</td>

                                <td>
                                    <strong>@item.Nombres @item.Apellidos</strong>
                                </td>

                                <td>
                                    @{
                                        var clubes = ViewBag.ClubesDirigidos as Dictionary<int, string>;
                                        string nombreClub = (clubes != null && clubes.ContainsKey(item.IdEntrenador))
                                        ? clubes[item.IdEntrenador]
                                        : "Sin club";
                                    }
                                    <span class="fw-bold text-primary">@nombreClub</span>
                                </td>

                                <td>@item.Especialidad</td>

                                <td>@item.AniosExperiencia años</td>

                                <td>@item.Telefono</td>

                                <td>@item.Correo</td>

                                <td>
                                    @if (item.EstadoActivo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactivo</span>
                                    }
                                </td>

                                <td class="text-center">
                                    @if (puedeGestionarEntrenadores)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.IdEntrenador" class="btn btn-warning btn-sm">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                    }
                                    <a asp-action="Details" asp-route-id="@item.IdEntrenador" class="btn btn-info btn-sm text-white">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td class="text-center text-muted">Sin registros</td>
                            <td class="text-center text-muted">-</td>
                            <td class="text-center text-muted">-</td>
                            <td class="text-center text-muted">-</td>
                            <td class="text-center text-muted">-</td>
                            <td class="text-center text-muted">-</td>
                            <td class="text-center text-muted">-</td>
                            <td class="text-center text-muted">-</td>
                            <td class="text-center text-muted">No hay entrenadores registrados.</td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            // Inicializamos DataTables usando el ID de la tabla
            $('#tablaEntrenadores').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json"
                },
                "pageLength": 10,
                "ordering": true,
                "info": true
            });
        });
    </script>
}
