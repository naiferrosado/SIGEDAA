@model IEnumerable<SIGEDAA.Models.Atleta>

@{
    ViewData["Title"] = "Atletas";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

<div class="d-flex justify-content-between mb-3">
    <h2>Atletas</h2>
    <div>
        <a class="btn btn-primary" asp-action="Create">Nuevo atleta</a>
        <a class="btn btn-secondary" asp-controller="Dashboard" asp-action="Index">Volver a la Pantalla Principal</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">No hay atletas registrados.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombres</th>
                <th>Apellidos</th>
                <th>Fecha Nac.</th>
                <th>Género</th>
                <th>Estatura (cm)</th>
                <th>Peso (kg)</th>
                <th>Tipo Sangre</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.IdAtleta</td>
                    <td>@a.Nombres</td>
                    <td>@a.Apellidos</td>
                    <td>@a.FechaNacimiento.ToString("yyyy-MM-dd")</td>
                    <td>@a.Genero</td>
                    <td>@a.EstaturaCm</td>
                    <td>@a.PesoKg</td>
                    <td>@a.TipoSangre</td>
                    <td>
                        <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@a.IdAtleta">Ver</a>
                        <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@a.IdAtleta">Editar</a>
                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@a.IdAtleta">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}