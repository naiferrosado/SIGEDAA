@model SIGEDAA.Models.Atleta

@{
    ViewData["Title"] = "Detalle Atleta";
    var puedeGestionarAtletas = User.IsInRole("Administrador") || User.IsInRole("Presidente");
}

<div class="page-header">
    <div>
        <h1>Perfil del atleta</h1>
        <p>Consulta los datos fisicos y administrativos del atleta seleccionado.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
        @if (puedeGestionarAtletas)
        {
            <a asp-action="Edit" asp-route-id="@Model.IdAtleta" class="btn btn-warning">Editar</a>
        }
    </div>
</div>

<div class="card p-3">
    <dl class="row description-list mb-0">
        <dt class="col-sm-3">Id</dt>
        <dd class="col-sm-9">@Model.IdAtleta</dd>
        <dt class="col-sm-3">Nombres</dt>
        <dd class="col-sm-9">@Model.Nombres</dd>
        <dt class="col-sm-3">Apellidos</dt>
        <dd class="col-sm-9">@Model.Apellidos</dd>
        <dt class="col-sm-3">Fecha Nacimiento</dt>
        <dd class="col-sm-9">@Model.FechaNacimiento.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-3">Género</dt>
        <dd class="col-sm-9">@Model.Genero</dd>
        <dt class="col-sm-3">Estatura (cm)</dt>
        <dd class="col-sm-9">@Model.EstaturaCm</dd>
        <dt class="col-sm-3">Peso (kg)</dt>
        <dd class="col-sm-9">@Model.PesoKg</dd>
        <dt class="col-sm-3">Tipo Sangre</dt>
        <dd class="col-sm-9">@Model.TipoSangre</dd>
        <dt class="col-sm-3">Id Club</dt>
        <dd class="col-sm-9">@Model.IdClub</dd>
    </dl>
</div>
