@model SIGEDAA.Models.Atleta

@{
    ViewData["Title"] = "Registrar Atleta";
}

<div class="page-header">
    <div>
        <h1>Registrar atleta</h1>
        <p>Completa los datos personales y asigna el club correspondiente desde la asociacion provincial.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
    </div>
</div>

<div class="card shadow-sm mx-auto" style="max-width: 800px;">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">Registrar Nuevo Atleta</h4>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Nombres" class="form-label"></label>
                    <input asp-for="Nombres" class="form-control" required />
                    <span asp-validation-for="Nombres" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Apellidos" class="form-label"></label>
                    <input asp-for="Apellidos" class="form-control" required />
                    <span asp-validation-for="Apellidos" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="FechaNacimiento" class="form-label">Fecha de Nacimiento</label>
                    <input asp-for="FechaNacimiento" class="form-control" type="date" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Genero" class="form-label">Género</label>
                    <select asp-for="Genero" class="form-select">
                        <option value="Masculino">Masculino</option>
                        <option value="Femenino">Femenino</option>
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="EstaturaCm" class="form-label">Estatura (cm)</label>
                    <input asp-for="EstaturaCm" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="PesoKg" class="form-label">Peso (kg)</label>
                    <input asp-for="PesoKg" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="TipoSangre" class="form-label">Tipo de Sangre</label>
                    <select asp-for="TipoSangre" class="form-select">
                        <option value="O+">O+</option>
                        <option value="O-">O-</option>
                        <option value="A+">A+</option>
                        <option value="A-">A-</option>
                        <option value="B+">B+</option>
                        <option value="B-">B-</option>
                        <option value="AB+">AB+</option>
                        <option value="AB-">AB-</option>
                    </select>
                </div>
            </div>

            <hr class="my-4" />
            <div class="section-title mb-3">Asignacion de club</div>

            <div class="row surface-muted p-3">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">1. Provincia / Asociación</label>
                    <select id="selectProvincia" class="form-select border-primary">
                        <option value="">-- Elija una Provincia --</option>
                        @foreach (var asoc in ViewBag.Asociaciones)
                        {
                            <option value="@asoc.Value">@asoc.Text</option>
                        }
                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">2. Club del Atleta</label>
                    <select asp-for="IdClub" id="selectClub" class="form-select border-success" required disabled>
                        <option value="">-- Primero elija una provincia --</option>
                    </select>
                    <span asp-validation-for="IdClub" class="text-danger"></span>
                </div>
            </div>

            <div class="page-actions mt-4">
                <button type="submit" class="btn btn-primary">Guardar Atleta</button>
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">Atrás</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://code.jquery.com/jquery-3.7.0.js"></script>
    <script>
        $(document).ready(function () {
            $("#selectProvincia").change(function () {
                var asocId = $(this).val();
                var selectClub = $("#selectClub");

                selectClub.empty();

                if (asocId) {
                    selectClub.prop("disabled", false);
                    selectClub.append('<option value="">Buscando clubes...</option>');

                    // Llama a nuestro nuevo método en AtletasController
                    $.getJSON('/Atletas/ObtenerClubesPorAsociacion', { idAsociacion: asocId }, function (data) {
                        selectClub.empty();

                        if(data.length > 0){
                            selectClub.append('<option value="">-- Seleccione el Club --</option>');
                            $.each(data, function (index, item) {
                                selectClub.append('<option value="' + item.valor + '">' + item.texto + '</option>');
                            });
                        } else {
                            selectClub.append('<option value="">No hay clubes en esta provincia</option>');
                            selectClub.prop("disabled", true);
                        }
                    });
                } else {
                    selectClub.append('<option value="">-- Primero elija una provincia --</option>');
                    selectClub.prop("disabled", true);
                }
            });
        });
    </script>
}
