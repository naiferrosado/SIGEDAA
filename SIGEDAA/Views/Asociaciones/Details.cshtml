@model SIGEDAA.Models.AsociacionProvincial

@{
    ViewData["Title"] = "Detalles de la Asociación";
    var clubes = ViewBag.Clubes as List<SIGEDAA.Models.Club>;
}

<div class="d-flex justify-content-between mb-3">
    <h2>Asociación: <span class="text-primary">@Model.NombreAsociacion</span></h2>
    <div>
        <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.IdAsociacion">Editar Asociación</a>
        <a class="btn btn-secondary" asp-action="Index">Volver a la lista</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="fas fa-people-group"></i> Clubes Registrados (@(clubes?.Count ?? 0))</h5>
    </div>
    <div class="card-body">
        @if (clubes == null || !clubes.Any())
        {
            <div class="alert alert-info mb-0">Esta asociación aún no tiene clubes registrados.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-bordered table-striped">
                    <thead class="table-light">
                        <tr>
                            <th>Nombre del Club</th>
                            <th>Director</th>
                            <th>Teléfono</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var club in clubes)
                        {
                            <tr>
                                <td class="fw-bold">@club.NombreClub</td>
                               
                                <td>@club.Telefono</td>
                                <td>
                                    @if (club.EstadoActivo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {

                                        <span class="badge bg-danger">Inactivo</span>
                                    }
                                </td>
                                <td>
                                    <a class="btn btn-sm btn-info" asp-controller="Clubes" asp-action="Details" asp-route-id="@club.IdClub">Ver Atletas</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>