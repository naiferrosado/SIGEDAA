@model SIGEDAA.Models.Usuario

@{
    ViewData["Title"] = "Perfil del Usuario";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4 mx-auto" style="max-width: 600px;">

        <div class="card-header bg-info text-white rounded-top-4 p-3 d-flex justify-content-between align-items-center">
            <h4 class="mb-0 fw-bold"><i class="fas fa-id-card me-2"></i> Perfil de Usuario</h4>
            @if (Model.EstadoActivo)
            {
                <span class="badge bg-success fs-6 shadow-sm">Cuenta Activa</span>
            }
            else
            {
                <span class="badge bg-danger fs-6 shadow-sm">Cuenta Inhabilitada</span>
            }
        </div>

        <div class="card-body p-5">

            <div class="text-center mb-4">
                <i class="fas fa-user-circle text-info" style="font-size: 5rem;"></i>
                <h3 class="mt-3 fw-bold">@Model.NombreCompleto</h3>
                <span class="badge bg-primary fs-6"><i class="fas fa-shield-alt me-1"></i> @Model.Rol</span>
            </div>

            <hr class="text-muted mb-4" />

            <div class="row">
                <div class="col-md-12 mb-4">
                    <h6 class="text-muted text-uppercase fw-bold mb-1"><i class="fas fa-envelope me-2"></i>Correo Electrónico</h6>
                    <p class="fs-5 mb-0 fw-semibold">@Model.CorreoElectronico</p>
                </div>

                <div class="col-md-6 mb-4">
                    <h6 class="text-muted text-uppercase fw-bold mb-1"><i class="fas fa-calendar-alt me-2"></i>Miembro Desde</h6>
                    <p class="fs-5 mb-0 fw-semibold">@Model.FechaRegistro.ToString("dd/MM/yyyy")</p>
                </div>

                <div class="col-md-6 mb-4">
                    <h6 class="text-muted text-uppercase fw-bold mb-1"><i class="fas fa-key me-2"></i>Clave de Acceso</h6>
                    <p class="fs-5 mb-0 fw-semibold text-muted">********</p>
                </div>
            </div>

        </div>

        <div class="card-footer bg-light p-3 border-0 rounded-bottom-4 d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-secondary shadow-sm">
                <i class="fas fa-arrow-left me-1"></i> Volver
            </a>
            <a asp-action="Edit" asp-route-id="@Model.IdUsuario" class="btn btn-warning shadow-sm fw-bold">
                <i class="fas fa-edit me-1"></i> Editar Perfil
            </a>
        </div>
    </div>
</div>