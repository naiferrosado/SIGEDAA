@model IEnumerable<SIGEDAA.Models.Usuario>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="container mt-4">

    <div class="page-header">
        <div>
            <h1>Usuarios del sistema</h1>
            <p>Administra accesos, roles y estado de las cuentas que operan dentro de SIGEDAA.</p>
        </div>
        <div class="page-actions">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary shadow-sm">
                Dashboard
            </a>
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="fas fa-user-plus me-1"></i> Nuevo Usuario
            </a>
        </div>
    </div>

    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body">

            <table class="table table-striped table-hover table-bordered align-middle" id="tablaUsuarios" style="width:100%">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre Completo</th>
                        <th>Correo Electrónico</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.NombreCompleto</strong></td>
                            <td>@item.CorreoElectronico</td>
                            <td>
                                <span class="badge bg-primary text-white"><i class="fas fa-user-shield me-1"></i> @item.Rol</span>
                            </td>
                            <td>
                                @if (item.EstadoActivo)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactivo</span>
                                }
                            </td>
                            <td class="text-center">
                                <a class="btn btn-sm btn-warning shadow-sm" asp-action="Edit" asp-route-id="@item.IdUsuario" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a class="btn btn-sm btn-info text-white shadow-sm" asp-action="Details" asp-route-id="@item.IdUsuario" title="Ver Detalles">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#tablaUsuarios').DataTable({
                "language": { "url": "//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json" },
                "pageLength": 10,
                "ordering": true
            });
        });
    </script>
}
