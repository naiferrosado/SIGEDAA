@{
    ViewData["Title"] = "Dashboard";
    var esAdministrador = User.IsInRole("Administrador");
    var esPresidente = User.IsInRole("Presidente");
    var esJuez = User.IsInRole("Juez");

    var puedeVerUsuarios = esAdministrador;
    var puedeVerAtletas = esAdministrador || esPresidente || esJuez;
    var puedeVerClubes = esAdministrador || esPresidente || esJuez;
    var puedeVerEntrenadores = esAdministrador || esPresidente || esJuez;
    var puedeVerCompetencias = esAdministrador || esJuez;
    var puedeVerAsociaciones = esAdministrador || esPresidente || esJuez;
    var puedeVerDisciplinas = esAdministrador;
    var puedeVerResultados = esAdministrador || esJuez;

    var nombreRol = esAdministrador ? "Administrador" : esPresidente ? "Presidente" : "Juez";
}

<div class="page-header mb-4">
    <div>
        <span class="section-title">Centro de control</span>
        <h1>Panel principal</h1>
    </div>
    <div class="dashboard-welcome">
        <span class="dashboard-welcome-label">Sesion activa</span>
        <strong>@Context.Session.GetString("usuario")</strong>
        <span class="app-role-pill">@nombreRol</span>
    </div>
</div>

<div class="dashboard-grid">
    <aside class="dashboard-sidebar card">
        <div class="card-body">
            <div class="dashboard-sidebar-brand">
                <div class="dashboard-sidebar-mark">
                    <i class="fa-solid fa-chart-pie"></i>
                </div>
                <div>
                    <h3>SIGEDAA</h3>
                </div>
            </div>

            <nav class="dashboard-nav">
                <a asp-controller="Dashboard" asp-action="Index" class="dashboard-nav-link active">
                    <i class="fa-solid fa-chart-line"></i>
                    <span>Dashboard</span>
                </a>
                @if (puedeVerUsuarios)
                {
                    <a asp-controller="Usuarios" asp-action="Index" class="dashboard-nav-link">
                        <i class="fa-solid fa-users"></i>
                        <span>Usuarios</span>
                    </a>
                }
                @if (puedeVerAtletas)
                {
                    <a asp-controller="Atletas" asp-action="Index" class="dashboard-nav-link">
                        <i class="fa-solid fa-running"></i>
                        <span>Atletas</span>
                    </a>
                }
                @if (puedeVerClubes)
                {
                    <a asp-controller="Clubes" asp-action="Index" class="dashboard-nav-link">
                        <i class="fa-solid fa-people-group"></i>
                        <span>Clubes</span>
                    </a>
                }
                @if (puedeVerEntrenadores)
                {
                    <a asp-controller="Entrenadores" asp-action="Index" class="dashboard-nav-link">
                        <i class="fa-solid fa-user-tie"></i>
                        <span>Entrenadores</span>
                    </a>
                }
                @if (puedeVerCompetencias)
                {
                    <a asp-controller="Competencias" asp-action="Index" class="dashboard-nav-link">
                        <i class="fa-solid fa-trophy"></i>
                        <span>Competencias</span>
                    </a>
                }
                @if (puedeVerAsociaciones)
                {
                    <a asp-controller="Asociaciones" asp-action="Index" class="dashboard-nav-link">
                        <i class="fa-solid fa-building"></i>
                        <span>Asociaciones</span>
                    </a>
                }
                @if (puedeVerDisciplinas)
                {
                    <a asp-controller="Disciplinas" asp-action="Index" class="dashboard-nav-link">
                        <i class="fa-solid fa-stopwatch"></i>
                        <span>Disciplinas</span>
                    </a>
                }
                @if (puedeVerResultados)
                {
                    <a asp-controller="Resultados" asp-action="Index" class="dashboard-nav-link">
                        <i class="fa-solid fa-medal"></i>
                        <span>Resultados</span>
                    </a>
                }
            </nav>

            <div class="dashboard-sidebar-footer">
                <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-danger w-100">
                    <i class="fa-solid fa-right-from-bracket me-2"></i>Cerrar sesion
                </a>
            </div>
        </div>
    </aside>

    <section class="dashboard-main">
        <div class="dashboard-hero card">
            <div class="card-body">
                <div class="dashboard-hero-copy">
                    <span class="section-title">Resumen</span>
                    <h2>SIGEDAA</h2>
                </div>
                <div class="dashboard-hero-badge">
                    <i class="fa-solid fa-shield-heart"></i>
                    <span>@nombreRol</span>
                </div>
            </div>
        </div>

        <div class="row g-4 mt-1">
            @if (puedeVerAtletas)
            {
                <div class="col-md-6 col-xl-3">
                    <a asp-controller="Atletas" asp-action="Index" class="dashboard-stat dashboard-stat-blue">
                        <div>
                            <span class="dashboard-stat-label">Atletas</span>
                            <strong>@(ViewBag.AtletasCount ?? 0)</strong>
                        </div>
                        <i class="fa-solid fa-running"></i>
                    </a>
                </div>
            }

            @if (puedeVerClubes)
            {
                <div class="col-md-6 col-xl-3">
                    <a asp-controller="Clubes" asp-action="Index" class="dashboard-stat dashboard-stat-green">
                        <div>
                            <span class="dashboard-stat-label">Clubes</span>
                            <strong>@(ViewBag.ClubesCount ?? 0)</strong>
                        </div>
                        <i class="fa-solid fa-people-group"></i>
                    </a>
                </div>
            }

            @if (puedeVerCompetencias)
            {
                <div class="col-md-6 col-xl-3">
                    <a asp-controller="Competencias" asp-action="Index" class="dashboard-stat dashboard-stat-orange">
                        <div>
                            <span class="dashboard-stat-label">Competencias</span>
                            <strong>@(ViewBag.TorneosCount ?? 0)</strong>
                        </div>
                        <i class="fa-solid fa-trophy"></i>
                    </a>
                </div>
            }

            @if (puedeVerResultados)
            {
                <div class="col-md-6 col-xl-3">
                    <a asp-controller="Resultados" asp-action="Index" class="dashboard-stat dashboard-stat-red">
                        <div>
                            <span class="dashboard-stat-label">Resultados</span>
                            <strong>@(ViewBag.ResultadosCount ?? 0)</strong>
                        </div>
                        <i class="fa-solid fa-medal"></i>
                    </a>
                </div>
            }
        </div>

        <div class="row g-4 mt-1">
            <div class="col-lg-8">
                <div class="card dashboard-panel h-100">
                    <div class="card-body">
                        <span class="section-title">Modulos</span>
                        <h3>Habilitados</h3>

                        <div class="dashboard-chip-list">
                            @if (puedeVerUsuarios)
                            {
                                <span class="dashboard-chip"><i class="fa-solid fa-users"></i> Usuarios</span>
                            }
                            @if (puedeVerAtletas)
                            {
                                <span class="dashboard-chip"><i class="fa-solid fa-running"></i> Atletas</span>
                            }
                            @if (puedeVerClubes)
                            {
                                <span class="dashboard-chip"><i class="fa-solid fa-people-group"></i> Clubes</span>
                            }
                            @if (puedeVerEntrenadores)
                            {
                                <span class="dashboard-chip"><i class="fa-solid fa-user-tie"></i> Entrenadores</span>
                            }
                            @if (puedeVerCompetencias)
                            {
                                <span class="dashboard-chip"><i class="fa-solid fa-trophy"></i> Competencias</span>
                            }
                            @if (puedeVerAsociaciones)
                            {
                                <span class="dashboard-chip"><i class="fa-solid fa-building"></i> Asociaciones</span>
                            }
                            @if (puedeVerDisciplinas)
                            {
                                <span class="dashboard-chip"><i class="fa-solid fa-stopwatch"></i> Disciplinas</span>
                            }
                            @if (puedeVerResultados)
                            {
                                <span class="dashboard-chip"><i class="fa-solid fa-medal"></i> Resultados</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card dashboard-panel h-100">
                    <div class="card-body">
                        <span class="section-title">Indicadores</span>
                        <h3>@nombreRol</h3>
                        <div class="dashboard-kpi-grid">
                            @if (esAdministrador)
                            {
                                <div class="dashboard-kpi-card">
                                    <span>Usuarios activos</span>
                                    <strong>@(ViewBag.UsuariosActivosCount ?? 0)</strong>
                                </div>
                                <div class="dashboard-kpi-card">
                                    <span>Disciplinas</span>
                                    <strong>@(ViewBag.DisciplinasCount ?? 0)</strong>
                                </div>
                            }

                            <div class="dashboard-kpi-card">
                                <span>Atletas activos</span>
                                <strong>@(ViewBag.AtletasActivosCount ?? 0)</strong>
                            </div>
                            <div class="dashboard-kpi-card">
                                <span>Clubes activos</span>
                                <strong>@(ViewBag.ClubesActivosCount ?? 0)</strong>
                            </div>
                            <div class="dashboard-kpi-card">
                                <span>Competencias abiertas</span>
                                <strong>@(ViewBag.TorneosActivosCount ?? 0)</strong>
                            </div>
                            <div class="dashboard-kpi-card">
                                <span>Asociaciones activas</span>
                                <strong>@(ViewBag.AsociacionesActivasCount ?? 0)</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
