@model IEnumerable<SIGEDAA.Models.Club>

@{
    ViewData["Title"] = "Clubes";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">

<div class="d-flex justify-content-between mb-3">
    <h2>Clubes Deportivos</h2>
    <div>
        <a class="btn btn-primary" asp-action="Create">Nuevo Club</a>
        <a class="btn btn-secondary" asp-controller="Dashboard" asp-action="Index">Volver al Dashboard</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card p-3 shadow-sm">
    <table id="tablaClubes" class="table table-striped table-bordered" style="width:100%">
        <thead>
            <tr>
                <th>Nombre del Club</th>
                <th>Asociación Provincial</th>
                <th>Director</th>
                <th>Teléfono</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.NombreClub</td>
                    <td>
                        @{
                            var dictAsociaciones = ViewBag.NombresAsociaciones as Dictionary<int, string>;
                            string nombreAsociacion = dictAsociaciones != null && dictAsociaciones.ContainsKey(item.IdAsociacion)
                            ? dictAsociaciones[item.IdAsociacion]
                            : "Sin Asociación";
                        }
                        @nombreAsociacion
                    </td>
                    <td>@item.NombreDirector</td>
                    <td>@item.Telefono</td>
                    <td>
                        @if (item.EstadoActivo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactivo</span>
                        }
                    </td>
                    <td>
                        <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.IdClub">Ver Detalles</a>
                        <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.IdClub">Editar</a>
                        <form asp-action="CambiarEstado" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@item.IdClub" />
                            @if (item.EstadoActivo)
                            {
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Inhabilitar este club?');">Inhabilitar</button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('¿Habilitar este club?');">Habilitar</button>
                            }
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#tablaClubes').DataTable({
                "language": { "url": "//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json" }
            });
        });
    </script>
}