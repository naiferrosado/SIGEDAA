@model SIGEDAA.Models.Club

@{
    ViewData["Title"] = "Editar Club";
}

<div class="card shadow-sm mx-auto" style="max-width: 800px;">
    <div class="card-header bg-warning text-dark">
        <h4 class="mb-0">Editar Club Deportivo</h4>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="IdClub" />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="NombreClub" class="form-label">Nombre del Club</label>
                    <input asp-for="NombreClub" class="form-control" required />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="IdAsociacion" class="form-label">Asociación Provincial a la que pertenece</label>
                    <select asp-for="IdAsociacion" class="form-select" asp-items="ViewBag.Asociaciones" required>
                        <option value="">-- Seleccione una Asociación --</option>
                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="NombreDirector" class="form-label">Director / Entrenador Principal</label>
                    <input asp-for="NombreDirector" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Telefono" class="form-label">Teléfono de Contacto</label>
                    <input asp-for="Telefono" class="form-control" />
                </div>
                <div class="col-md-12 mb-3">
                    <label asp-for="DireccionSede" class="form-label">Dirección (Sede de Entrenamiento)</label>
                    <input asp-for="DireccionSede" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="FechaInscripcion" class="form-label">Fecha de Inscripción</label>
                    <input asp-for="FechaInscripcion" class="form-control" type="date" />
                </div>
                <div class="col-md-12 mb-3 form-check ms-2 mt-2">
                    <input asp-for="EstadoActivo" class="form-check-input" type="checkbox" />
                    <label asp-for="EstadoActivo" class="form-check-label">Club Activo</label>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-warning">Actualizar Club</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}