@model SIGEDAA.Models.ResultadoCompetencia

@{
    ViewData["Title"] = "Editar Resultado";
}

<div class="card shadow-sm mx-auto" style="max-width: 800px;">
    <div class="card-header bg-warning text-dark">
        <h4 class="mb-0 fw-bold"><i class="fas fa-edit"></i> Corregir Marca Obtenida</h4>
    </div>
    <div class="card-body p-4">
        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="IdResultado" />
            <input type="hidden" asp-for="IdCompetencia" />
            <input type="hidden" asp-for="IdAtleta" />
            <input type="hidden" asp-for="IdClub" />
            <input type="hidden" asp-for="IdDisciplina" />
            <input type="hidden" asp-for="PosicionFinal" />

            <div class="row">
                <div class="col-md-12 mb-4">
                    <label class="form-label fw-bold text-muted">Torneo / Competencia</label>
                    <input type="text" class="form-control bg-light" value="@Model.Competencia?.NombreEvento" readonly />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold text-muted">Atleta</label>
                    <input type="text" class="form-control bg-light" value="@Model.Atleta?.Nombres @Model.Atleta?.Apellidos" readonly />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold text-muted">Club</label>
                    <input type="text" class="form-control bg-light" value="@Model.Club?.NombreClub" readonly />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold text-muted">Disciplina</label>
                    <input type="text" class="form-control bg-light" value="@Model.Disciplina?.NombreDisciplina" readonly />
                </div>

                <div class="col-md-6 mb-4">
                    <label asp-for="MarcaObtenida" class="form-label fw-bold text-primary">Corregir Marca</label>
                    <div class="input-group">
                        <span class="input-group-text bg-warning text-dark"><i class="fas fa-flag-checkered"></i></span>
                        <input asp-for="MarcaObtenida" class="form-control border-warning shadow-sm" required />
                    </div>
                    <span asp-validation-for="MarcaObtenida" class="text-danger small"></span>
                    <small class="text-muted mt-1 d-block">Las posiciones se recalcularán automáticamente.</small>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-2">
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-warning fw-bold px-4"><i class="fas fa-save"></i> Guardar Cambios</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}