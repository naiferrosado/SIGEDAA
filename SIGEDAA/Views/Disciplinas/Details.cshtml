@model SIGEDAA.Models.Disciplina

@{
    ViewData["Title"] = "Detalles de la Disciplina";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4 mx-auto" style="max-width: 700px;">

        <div class="card-header bg-info text-white rounded-top-4 p-3 d-flex justify-content-between align-items-center">
            <h4 class="mb-0 fw-bold"><i class="fas fa-eye me-2"></i> Detalles de la Disciplina</h4>
            <span class="badge bg-light text-dark fs-6 shadow-sm">ID: #@Model.IdDisciplina</span>
        </div>

        <div class="card-body p-5">

            <div class="text-center mb-4">
                <i class="fas fa-medal text-info" style="font-size: 4rem;"></i>
                <h3 class="mt-3 fw-bold text-uppercase">@Model.NombreDisciplina</h3>
                <p class="text-muted fs-5">@Model.CategoriaRecomendada</p>
            </div>

            <hr class="text-muted mb-4" />

            <div class="row">
                <div class="col-md-6 mb-4">
                    <h6 class="text-muted text-uppercase fw-bold mb-1"><i class="fas fa-layer-group me-2"></i>Tipo</h6>
                    <p class="fs-5 mb-0 fw-semibold">@Model.Tipo</p>
                </div>

                <div class="col-md-6 mb-4">
                    <h6 class="text-muted text-uppercase fw-bold mb-1"><i class="fas fa-stopwatch me-2"></i>Medición</h6>
                    <p class="fs-5 mb-0 fw-semibold">@Model.TipoMedicion</p>
                </div>

                <div class="col-md-6 mb-4">
                    <h6 class="text-muted text-uppercase fw-bold mb-1"><i class="fas fa-venus-mars me-2"></i>Género Permitido</h6>
                    <p class="fs-5 mb-0 fw-semibold">@Model.GeneroPermitido</p>
                </div>

                <div class="col-md-6 mb-4">
                    <h6 class="text-muted text-uppercase fw-bold mb-1"><i class="fas fa-exchange-alt me-2"></i>¿Es Relevo?</h6>
                    <p class="fs-5 mb-0 fw-semibold">
                        @(Model.EsRelevo ? "Sí, es una prueba de relevo" : "No, prueba individual")
                    </p>
                </div>

                <div class="col-md-12 mb-2">
                    <h6 class="text-muted text-uppercase fw-bold mb-1"><i class="fas fa-book me-2"></i>Reglas / Descripción</h6>
                    <div class="p-3 bg-light rounded-3 border">
                        <p class="mb-0">@Model.DescripcionReglas</p>
                    </div>
                </div>
            </div>

        </div>

        <div class="card-footer bg-light p-3 border-0 rounded-bottom-4 d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-secondary shadow-sm">
                <i class="fas fa-arrow-left me-1"></i> Volver a la Lista
            </a>
            <a asp-action="Edit" asp-route-id="@Model.IdDisciplina" class="btn btn-warning shadow-sm fw-bold">
                <i class="fas fa-edit me-1"></i> Editar Disciplina
            </a>
        </div>
    </div>
</div>