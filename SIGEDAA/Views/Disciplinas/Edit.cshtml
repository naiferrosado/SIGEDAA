@model SIGEDAA.Models.Disciplina

@{
    ViewData["Title"] = "Editar Disciplina";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4 mx-auto" style="max-width: 600px;">

        <div class="card-header bg-warning text-dark rounded-top-4 p-3">
            <h4 class="mb-0 fw-bold"><i class="fas fa-edit me-2"></i> Editar Disciplina</h4>
        </div>

        <div class="card-body p-4">
            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="IdDisciplina" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger fw-bold" role="alert"></div>

                <div class="mb-4">
                    <label asp-for="NombreDisciplina" class="form-label fw-bold">Nombre de la Disciplina</label>
                    <input asp-for="NombreDisciplina" class="form-control border-warning shadow-sm" required />
                    <span asp-validation-for="NombreDisciplina" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Tipo" class="form-label fw-bold">Tipo (Pista, Campo, etc.)</label>
                    <input asp-for="Tipo" class="form-control shadow-sm" required />
                    <span asp-validation-for="Tipo" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="TipoMedicion" class="form-label fw-bold">Tipo de Medición</label>
                    <select asp-for="TipoMedicion" class="form-select shadow-sm">
                        <option value="Tiempo">Tiempo (Cronómetro)</option>
                        <option value="Distancia">Distancia (Metros/Centímetros)</option>
                    </select>
                    <span asp-validation-for="TipoMedicion" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="CategoriaRecomendada" class="form-label fw-bold">Categoría Recomendada</label>
                    <input asp-for="CategoriaRecomendada" class="form-control shadow-sm" />
                    <span asp-validation-for="CategoriaRecomendada" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-secondary shadow-sm">
                        <i class="fas fa-times me-1"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-warning shadow-sm fw-bold">
                        <i class="fas fa-save me-1"></i> Guardar Cambios
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}