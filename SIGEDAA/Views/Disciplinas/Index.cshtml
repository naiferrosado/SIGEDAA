@model IEnumerable<SIGEDAA.Models.Disciplina>
@{
    ViewData["Title"] = "Disciplinas";
}

<div class="d-flex justify-content-between mb-3">
    <h2>Disciplinas Deportivas</h2>
    <a class="btn btn-primary" asp-action="Create">Nueva Disciplina</a>
</div>

<div class="card p-3 shadow-sm">
    <table class="table table-striped table-bordered" id="tablaDisciplinas">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Tipo</th>
                <th>Medición</th>
                <th>Categoría</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.NombreDisciplina</strong></td>
                    <td>@item.Tipo</td>
                    <td>@item.TipoMedicion</td>
                    <td>@item.CategoriaRecomendada</td>
                    <td>
                        <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.IdDisciplina">Editar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaDisciplinas').DataTable({ "language": { "url": "//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json" } });
        });
    </script>
}