@model IEnumerable<SIGEDAA.Models.Disciplina>

@{
    ViewData["Title"] = "Disciplinas";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="container mt-4">

    <div class="page-header">
        <div>
            <h1>Disciplinas deportivas</h1>
            <p>Configura las pruebas del sistema, sus reglas, categoria recomendada y tipo de medicion.</p>
        </div>
        <div class="page-actions">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary shadow-sm">
                Dashboard
            </a>
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="fas fa-plus me-1"></i> Nueva Disciplina
            </a>
        </div>
    </div>

    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body">

            <table class="table table-striped table-hover table-bordered align-middle" id="tablaDisciplinas" style="width:100%">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre de la Prueba</th>
                        <th>Tipo</th>
                        <th>Medición</th>
                        <th>Categoría</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.NombreDisciplina</strong></td>
                            <td>@item.Tipo</td>
                            <td>
                                @if (item.TipoMedicion == "Tiempo")
                                {
                                    <span class="badge bg-info text-dark"><i class="fas fa-stopwatch me-1"></i> @item.TipoMedicion</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="fas fa-ruler me-1"></i> @item.TipoMedicion</span>
                                }
                            </td>
                            <td>@item.CategoriaRecomendada</td>

                            <td class="text-center">
                                <a class="btn btn-sm btn-warning shadow-sm" asp-action="Edit" asp-route-id="@item.IdDisciplina" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a class="btn btn-sm btn-info text-white shadow-sm" asp-action="Details" asp-route-id="@item.IdDisciplina" title="Ver Detalles">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a class="btn btn-sm btn-danger shadow-sm" asp-action="Delete" asp-route-id="@item.IdDisciplina" title="Eliminar">
                                    <i class="fas fa-trash-alt"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#tablaDisciplinas').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json"
                },
                "pageLength": 10,
                "ordering": true,
                "info": true
            });
        });
    </script>
}
