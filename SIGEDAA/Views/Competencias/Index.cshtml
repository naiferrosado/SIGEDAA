@model IEnumerable<SIGEDAA.Models.Competencia>

@{
    ViewData["Title"] = "Torneos y Competencias";
    var esAdministrador = User.IsInRole("Administrador");
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">

<div class="page-header">
    <div>
        <h1>Torneos y competencias</h1>
        <p>Organiza el calendario competitivo, administra inscripciones y manten el control del estado de cada evento.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="Create">Nuevo Torneo</a>
        <a class="btn btn-secondary" asp-action="ExportarCsv">Exportar CSV</a>
        <a class="btn btn-secondary" asp-controller="Dashboard" asp-action="Index">Volver al Dashboard</a>
    </div>
</div>

<div class="card p-3 shadow-sm">
    <table id="tablaCompetencias" class="table table-striped table-bordered" style="width:100%">
        <thead class="table-dark">
            <tr>
                <th>Nombre del Evento</th>
                <th>Sede</th>
                <th>Inicio</th>
                <th>Fin</th>
                <th>Nivel</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.NombreEvento</strong></td>
                    <td>@item.Sede</td>
                    <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                    <td>@item.FechaFin.ToString("dd/MM/yyyy")</td>
                    <td>@item.Nivel</td>
                    <td>
                        @if (item.Estado == "Programada")
                        {
                            <span class="badge bg-info text-dark">@item.Estado</span>
                        }
                        else if (item.Estado == "En Curso")
                        {
                            <span class="badge bg-success">@item.Estado</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@item.Estado</span>
                        }
                    </td>
                    <td>
                        <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.IdCompetencia">
                            <i class="fas fa-eye"></i> Detalles
                        </a>

                        <a class="btn btn-sm btn-success" asp-action="InscribirClub" asp-route-id="@item.IdCompetencia">
                            <i class="fas fa-users"></i> Inscribir
                        </a>

                        <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.IdCompetencia">Editar</a>
                        @if (esAdministrador)
                        {
                            <form asp-action="Delete" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@item.IdCompetencia" />
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Seguro que deseas eliminar este torneo?');">Eliminar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#tablaCompetencias').DataTable({
                "language": { "url": "//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json" },
                "order": [[2, "asc"]] // Ordenar por fecha de inicio por defecto
            });
        });

    </script>
}
