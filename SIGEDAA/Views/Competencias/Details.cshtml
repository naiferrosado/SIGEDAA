@model SIGEDAA.Models.Competencia

@{
    ViewData["Title"] = "Detalles del Torneo";
}

<div class="page-header">
    <div>
        <h1>Detalle del torneo</h1>
        <p>Consulta el estado actual del evento, sus observaciones y los clubes inscritos.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.IdCompetencia">Editar Torneo</a>
        <a class="btn btn-secondary" asp-action="Index">Volver a la lista</a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-dark text-white">
        <h5 class="mb-0"><i class="fas fa-info-circle"></i> Información General</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6 mb-2">
                <strong>Sede / Ubicación:</strong> @Model.Sede
            </div>
            <div class="col-md-6 mb-2">
                <strong>Nivel:</strong> @Model.Nivel
            </div>
            <div class="col-md-6 mb-2">
                <strong>Fecha de Inicio:</strong> @Model.FechaInicio.ToString("dd/MM/yyyy")
            </div>
            <div class="col-md-6 mb-2">
                <strong>Fecha de Finalización:</strong> @Model.FechaFin.ToString("dd/MM/yyyy")
            </div>
            <div class="col-md-6 mb-2">
                <strong>Estado Actual:</strong>
                @if (Model.Estado == "Programada")
                {
                    <span class="badge bg-info text-dark">@Model.Estado</span>
                }
                else if (Model.Estado == "En Curso")
                {
                    <span class="badge bg-success">@Model.Estado</span>
                }
                else
                {
                    <span class="badge bg-secondary">@Model.Estado</span>
                }
            </div>
            <div class="col-md-12 mt-2">
                <strong>Observaciones:</strong>
                <p class="text-muted">@(string.IsNullOrEmpty(Model.Observaciones) ? "Ninguna" : Model.Observaciones)</p>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-shield-alt"></i> Clubes Inscritos (@(Model.ClubesInscritos?.Count ?? 0))</h5>

        @if (Model.Estado != "Finalizada")
        {
            <a asp-action="InscribirClub" asp-route-id="@Model.IdCompetencia" class="btn btn-sm btn-light text-success fw-bold">
                Inscribir Nuevo Club
            </a>
        }
    </div>
    <div class="card-body">
        @if (Model.ClubesInscritos == null || !Model.ClubesInscritos.Any())
        {
            <div class="alert alert-warning mb-0">
                Aún no hay clubes inscritos en este torneo.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-bordered table-striped">
                    <thead class="table-light">
                        <tr>
                            <th>Nombre del Club</th>
                            <th>Fecha de Inscripción</th>
                            <th>Estado de Inscripción</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inscripcion in Model.ClubesInscritos)
                        {
                            <tr>
                                <td class="fw-bold">@(inscripcion.Club?.NombreClub ?? "Sin club")</td>
                                <td>@inscripcion.FechaInscripcion.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge bg-success">@inscripcion.EstadoInscripcion</span></td>
                                <td>
                                    <a class="btn btn-sm btn-info" asp-controller="Clubes" asp-action="Details" asp-route-id="@inscripcion.IdClub">Ver Club</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
