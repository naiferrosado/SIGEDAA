@{
    Layout = null;
    ViewData["Title"] = "Acceso denegado";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceso denegado - SIGEDAA</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <style>
        body {
            min-height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #0f172a, #1d4ed8);
            font-family: "Segoe UI", sans-serif;
        }

        .access-card {
            width: min(560px, 92vw);
            background: #ffffff;
            border-radius: 18px;
            padding: 40px;
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.18);
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="access-card">
        <h1 class="fw-bold text-danger mb-3">Acceso denegado</h1>
        <p class="text-muted mb-4">
            Tu usuario ha iniciado sesion, pero no tiene permisos para acceder a esta seccion.
        </p>
        <div class="d-flex justify-content-center gap-2 flex-wrap">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">Volver al dashboard</a>
            <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-secondary">Cerrar sesion</a>
        </div>
    </div>
</body>
</html>
