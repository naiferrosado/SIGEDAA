@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Login - SIGEDAA</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-shell">
    <main class="auth-page">
        <section class="auth-showcase">
            <div class="auth-brand-badge">
                <i class="fa-solid fa-trophy"></i>
                <span>SIGEDAA</span>
            </div>

            <h1>SIGEDAA</h1>

            <div class="auth-highlights">
                <div class="auth-highlight">
                    <i class="fa-solid fa-shield-halved"></i>
                    <div>
                        <strong>Bienvenido a SIGEDAA</strong>
                    </div>
                </div>
                <div class="auth-highlight">
                    <i class="fa-solid fa-chart-line"></i>
                    <div>
                        <strong>Gestion deportiva centralizada</strong>
                    </div>
                </div>
                <div class="auth-highlight">
                    <i class="fa-solid fa-medal"></i>
                    <div>
                        <strong>Atletas, clubes y competencias</strong>
                    </div>
                </div>
            </div>
        </section>

        <section class="auth-panel">
            <div class="auth-card">
                <div class="auth-card-header">
                    <div class="auth-card-icon">
                        <i class="fa-solid fa-user-lock"></i>
                    </div>
                    <div>
                        <span class="section-title">Acceso</span>
                        <h2>Iniciar sesion</h2>
                    </div>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger auth-alert" role="alert">
                        <i class="fa-solid fa-circle-exclamation me-2"></i>@ViewBag.Error
                    </div>
                }

                <form method="post" asp-controller="Auth" asp-action="Login" class="auth-form">
                    <div class="mb-3">
                        <label class="form-label">Correo electronico</label>
                        <div class="auth-input">
                            <i class="fa-solid fa-envelope"></i>
                            <input type="email" name="Email" class="form-control" placeholder="correo@ejemplo.com" required>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Contrasena</label>
                        <div class="auth-input">
                            <i class="fa-solid fa-lock"></i>
                            <input type="password" name="password" class="form-control" placeholder="Ingresa tu contrasena" required>
                        </div>
                    </div>

                    <button type="submit" class="btn auth-submit w-100">
                        <i class="fa-solid fa-arrow-right-to-bracket me-2"></i>Entrar
                    </button>
                </form>
            </div>
        </section>
    </main>
</body>
</html>
